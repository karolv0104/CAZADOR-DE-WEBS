# Copia este archivo a .env.local y completa los valores reales.
# .env.local nunca se sube a git (ver .gitignore).

# Número de WhatsApp para el checkout del carrito y el botón flotante de
# consultas. Formato: código de país + número, SIN el signo "+".
# Ejemplo: 15551234567
NEXT_PUBLIC_WHATSAPP_NUMBER=

# API key de Anthropic para el chatbot educativo (server-side, NO lleva NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
